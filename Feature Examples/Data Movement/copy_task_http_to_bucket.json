{
    "definitions": {
        "descriptor": "copy_task_http_to_bucket",
        "source": "http://download.opencontent.netflix.com.s3.amazonaws.com/Meridian/subtitles/STL/Meridian_en_CC.stl",
        "destination_path": "s3://hybrik-examples/public/output/feature_examples/data_movement/{{descriptor}}"
    },
    "name": "{{descriptor}}: {{source}}",
    "payload": {
        "elements": [
            {
                "uid": "source_file",
                "kind": "source",
                "payload": {
                    "kind": "asset_url",
                    "payload": {
                        "storage_provider": "http",
                        "url": "{{source}}"
                    }
                }
            },
            {
                "uid": "copy_task",
                "kind": "copy",
                "task": {
                    "retry_method": "fail"
                },
                "payload": {
                    "target": {
                        "location": {
                            "storage_provider": "s3",
                            "path": "{{destination_path}}"
                        },
                        "existing_files": "replace",
                        "file_pattern": "{source_name}"
                    }
                }
            }
        ],
        "connections": [
            {
                "from": [
                    {
                        "element": "source_file"
                    }
                ],
                "to": {
                    "success": [
                        {
                            "element": "copy_task" 
                        }
                    ]
                }
            }
        ]
    }
}
    



        
